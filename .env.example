# Required for the discovery run (Phase 7). Not needed for replay.
# Create a WORKSPACE-SCOPED key at https://console.anthropic.com/settings/keys
# (an identity-linked key additionally requires an anthropic-workspace-id header).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: absolute path to a Chromium binary.
# Leave unset to use the browser Playwright manages itself (`playwright install chromium`).
# Set it when the environment ships a Chromium whose build differs from the pinned
# Playwright version -- e.g. a preinstalled one at /opt/pw-browsers/chromium.
# CUA_CHROMIUM_PATH=/opt/pw-browsers/chromium
